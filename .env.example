# Database
DB_URL=jdbc:mysql://localhost:3306/trademate?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# OpenAPI (공공데이터포털 - 주식시세)
OPENAPI_URL=https://apis.data.go.kr/1160100/service/GetStockSecuritiesInfoService/getStockPriceInfo
OPENAPI_SERVICE_KEY=your_openapi_service_key

# DART OpenAPI (금융감독원 전자공시)
DART_API_URL=https://opendart.fss.or.kr/api
DART_API_KEY=your_dart_api_key

# JWT
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long
